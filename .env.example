# ─────────────────────────────────────────────────────────────────────────────
# NOI Defense — environment
#
# Copy to `.env.local` and fill in. NEVER commit real keys.
#
# Everything here is VITE_-prefixed, which means it is BUNDLED INTO THE CLIENT
# and publicly readable. Only put keys here that are safe to expose and that you
# have domain-restricted / rate-limited at the provider. Any key that must stay
# secret (a Supabase service_role key, an indexer admin token) belongs on a
# server, not in this file.
# ─────────────────────────────────────────────────────────────────────────────

# --- Chains --------------------------------------------------------------------
# The chain a fresh session starts on. Users pick per scan from the full list.
#   1 Ethereum · 8453 Base · 42161 Arbitrum · 10 Optimism · 137 Polygon
#   56 BNB Chain · 43114 Avalanche · 534352 Scroll · 324 zkSync
#   84532 Base Sepolia · 11155111 Sepolia
VITE_CHAIN_ID=8453

# --- RPC -----------------------------------------------------------------------
# Resolution order per chain:
#   1. VITE_RPC_URL_<chainId>   per-chain override, always wins
#   2. VITE_RPC_URL             legacy single setting — DEFAULT CHAIN ONLY
#   3. Alchemy                  any chain with an Alchemy endpoint
#   4. the chain's public RPC   (rate-limited; fine for development)

# One Alchemy key covers every supported network. Restrict it to your domains.
VITE_ALCHEMY_API_KEY=

# Per-chain overrides. Add only the chains you want to pin to a specific
# provider — anything omitted falls through to Alchemy, then the public RPC.
# VITE_RPC_URL_1=https://eth-mainnet.example.com/v2/<key>
# VITE_RPC_URL_8453=https://base-mainnet.example.com/v2/<key>
# VITE_RPC_URL_42161=
# VITE_RPC_URL_10=
# VITE_RPC_URL_137=
# VITE_RPC_URL_56=
# VITE_RPC_URL_43114=
# VITE_RPC_URL_534352=
# VITE_RPC_URL_324=

# Legacy single RPC. Applies ONLY to VITE_CHAIN_ID above — pointing every
# network at one endpoint would serve one chain's data under another's name.
# Prefer the per-chain form.
VITE_RPC_URL=

# --- Explorers -----------------------------------------------------------------
# Each chain ships with a sensible default explorer. Override only if you run
# a private or alternate one.
# VITE_EXPLORER_URL_1=https://etherscan.io
# VITE_EXPLORER_URL_8453=https://basescan.org

# Legacy single explorer. Applies ONLY to the default chain.
VITE_EXPLORER_URL=

# --- Supabase (auth + app data) -------------------------------------------------
# Publishable (anon) key only. Guard every table with row-level security.
# Google sign-in also requires the Google provider to be enabled in
# Supabase Auth, with this app's origin listed as a redirect URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
