# NOI Defense — indexing worker
#
# This process holds the SERVICE ROLE key. It must never run in a browser or be
# bundled into the frontend: that key bypasses row level security entirely.

SUPABASE_URL=https://rzhnmtfhlpviiagrnsdo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# One key covers every network Alchemy supports. Without it the worker falls
# back to public RPCs, which are heavily rate-limited for log queries.
ALCHEMY_API_KEY=

# Per-chain RPC overrides, same convention as the frontend.
# RPC_URL_1=
# RPC_URL_8453=

# Seconds to wait when the queue is empty.
POLL_INTERVAL_SECONDS=5
# Upper bound on how far back to walk. Full history on a busy old token can be
# millions of blocks; this keeps a single job bounded and predictable.
MAX_BLOCK_LOOKBACK=400000
